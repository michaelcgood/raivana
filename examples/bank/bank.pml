// NGAC policy (PML) generated by Raivana for policy 'bank'
// Fingerprint 3ef8f217bee9190e. NGAC is deny-by-default: access requires an association.

create policy class "bank"

create user attribute "all_users" in ["bank"]
create user attribute "role=teller" in ["all_users"]
create user attribute "role=manager" in ["all_users"]
create user attribute "role=cfo" in ["all_users"]
create user attribute "employment_type=employee" in ["all_users"]
create user attribute "role=accountant" in ["all_users"]
create user attribute "role=auditor" in ["all_users"]
create user attribute "employment_type=contractor" in ["all_users"]

create object attribute "all_objects" in ["bank"]
create object attribute "type=account" in ["all_objects"]
create object attribute "type=transaction" in ["all_objects"]
create object attribute "type=expense_report" in ["all_objects"]
create object attribute "type=financial_report" in ["all_objects"]
create object attribute "type=payroll" in ["all_objects"]

// r1: ALLOW users whose role is teller to perform read on resources where type is account, when the time is at or after 09:00 and the time is before 17:00.
associate "role=teller" and "type=account" with ["read"]
// r3: ALLOW users whose role is manager to perform approve on resources where type is transaction and amount is at most 25000.
associate "role=manager" and "type=transaction" with ["approve"]
// r4: ALLOW users whose role is cfo to perform approve on resources where type is transaction and amount is greater than 25000.
associate "role=cfo" and "type=transaction" with ["approve"]
// r7: ALLOW users whose role is accountant to perform read, write on resources where type is financial report, when network is corporate.
associate "role=accountant" and "type=financial_report" with ["read", "write"]
// r9: ALLOW users whose role is auditor to perform read on resources where type is financial report.
associate "role=auditor" and "type=financial_report" with ["read"]

// r2: DENY users whose role is teller to perform approve on resources where type is transaction.
create prohibition "r2-role=teller" deny user attribute "role=teller" access rights ["approve"] on intersection of ["type=transaction"]
// r6: DENY users whose employment type is employee to perform approve on resources where type is expense report and the resource belongs to them.
create prohibition "r6-employment_type=employee" deny user attribute "employment_type=employee" access rights ["approve"] on intersection of ["type=expense_report"]
// r8: DENY users whose role is accountant to perform read, write on resources where type is financial report, when network is not corporate.
create prohibition "r8-role=accountant" deny user attribute "role=accountant" access rights ["read", "write"] on intersection of ["type=financial_report"]
// r10: DENY users whose role is auditor to perform write, create, delete, approve, share, export, initiate, reconcile on resources where type is financial report.
create prohibition "r10-role=auditor" deny user attribute "role=auditor" access rights ["write", "create", "delete", "approve", "share", "export", "initiate", "reconcile"] on intersection of ["type=financial_report"]
// r11: DENY users whose employment type is contractor to perform export on resources where type is payroll.
create prohibition "r11-employment_type=contractor" deny user attribute "employment_type=contractor" access rights ["export"] on intersection of ["type=payroll"]

// Not expressible as NGAC assignments/associations; enforce as obligations or at the PEP:
//   [r1] environment.hour >= 9 -- environment condition (enforce via PEP/obligation)
//   [r1] environment.hour < 17 -- environment condition (enforce via PEP/obligation)
//   [r3] resource.amount <= 25000 -- numeric threshold (enforce via PEP/obligation)
//   [r4] resource.amount > 25000 -- numeric threshold (enforce via PEP/obligation)
//   [r5] resource.amount > 25000 -- numeric threshold (enforce via PEP/obligation)
//   [r5] subject.role != "cfo" -- negated subject in a prohibition; covered by NGAC default deny only when no association grants the access
//   [r6] resource.owner == subject.id -- attribute-to-attribute relation (enforce via PEP/obligation)
//   [r7] environment.network == "corporate" -- environment condition (enforce via PEP/obligation)
//   [r8] environment.network != "corporate" -- environment condition (enforce via PEP/obligation)
