// Cedar semantics: forbid overrides permit; requests that match no permit are denied.

// ALLOW users whose role is doctor to perform prescribe on resources where type is prescription.
// Source: Only doctors can prescribe medication.
@id("r1")
permit (
  principal,
  action == Action::"prescribe",
  resource
)
when {
  (principal has role && principal.role == "doctor") &&
  (resource has type && resource.type == "prescription")
};

// DENY users whose role is not doctor to perform prescribe on resources where type is prescription.
// Source: Only doctors can prescribe medication.
@id("r2")
forbid (
  principal,
  action == Action::"prescribe",
  resource
)
when {
  !(principal has role && principal.role == "doctor") &&
  (resource has type && resource.type == "prescription")
};

// ALLOW users whose role is nurse to perform read on resources where type is medical record, when the time is at or after 09:00 and the time is before 17:00.
// Source: Nurses may view patient records during business hours.
@id("r3")
permit (
  principal,
  action == Action::"read",
  resource
)
when {
  (principal has role && principal.role == "nurse") &&
  (resource has type && resource.type == "medical_record") &&
  (context has hour && context.hour >= 9) &&
  (context has hour && context.hour < 17)
};

// ALLOW users whose role is nurse to perform read on resources where type is medical record, when emergency is satisfied.
// Source: Nurses can view any patient record in an emergency.
@id("r4")
permit (
  principal,
  action == Action::"read",
  resource
)
when {
  (principal has role && principal.role == "nurse") &&
  (resource has type && resource.type == "medical_record") &&
  (context has emergency && context.emergency == true)
};

// ALLOW users whose role is doctor to perform write on resources where type is medical record and the resource's department matches the subject's department.
// Source: Physicians may update medical records of patients in their department.
@id("r5")
permit (
  principal,
  action == Action::"write",
  resource
)
when {
  (principal has role && principal.role == "doctor") &&
  (resource has type && resource.type == "medical_record") &&
  (resource has department && principal has department && resource.department == principal.department)
};

