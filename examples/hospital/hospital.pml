// NGAC policy (PML) generated by Raivana for policy 'hospital'
// Fingerprint dacb8b64e77e8b85. NGAC is deny-by-default: access requires an association.

create policy class "hospital"

create user attribute "all_users" in ["hospital"]
create user attribute "role=doctor" in ["all_users"]
create user attribute "role=nurse" in ["all_users"]
create user attribute "role=billing_clerk" in ["all_users"]
create user attribute "role=receptionist" in ["all_users"]
create user attribute "role=psychiatrist" in ["all_users"]
create user attribute "employment_type=contractor" in ["all_users"]

create object attribute "all_objects" in ["hospital"]
create object attribute "type=prescription" in ["all_objects"]
create object attribute "type=medical_record" in ["all_objects"]
create object attribute "type=billing_record" in ["all_objects"]
create object attribute "type=appointment" in ["all_objects"]
create object attribute "sensitivity=psychotherapy" in ["all_objects"]
create object attribute "type=audit_log" in ["all_objects"]

// r1: ALLOW users whose role is doctor to perform prescribe on resources where type is prescription.
associate "role=doctor" and "type=prescription" with ["prescribe"]
// r3: ALLOW users whose role is nurse to perform read on resources where type is medical record, when the time is at or after 09:00 and the time is before 17:00.
associate "role=nurse" and "type=medical_record" with ["read"]
// r4: ALLOW users whose role is nurse to perform read on resources where type is medical record, when emergency is satisfied.
associate "role=nurse" and "type=medical_record" with ["read"]
// r5: ALLOW users whose role is doctor to perform write on resources where type is medical record and the resource's department matches the subject's department.
associate "role=doctor" and "type=medical_record" with ["write"]
// r6: ALLOW users whose role is billing clerk to perform read on resources where type is billing record.
associate "role=billing_clerk" and "type=billing_record" with ["read"]
// r8: ALLOW users whose role is receptionist to perform create, write on resources where type is appointment.
associate "role=receptionist" and "type=appointment" with ["create", "write"]
// r9: ALLOW users whose role is psychiatrist to perform read on resources where sensitivity is psychotherapy.
associate "role=psychiatrist" and "sensitivity=psychotherapy" with ["read"]
// r12: ALLOW users whose employment type is contractor to perform any action on resources where type is medical record, when network is corporate.
associate "employment_type=contractor" and "type=medical_record" with ["*"]

// r7: DENY users whose role is billing clerk to perform read on resources where type is medical record.
create prohibition "r7-role=billing_clerk" deny user attribute "role=billing_clerk" access rights ["read"] on intersection of ["type=medical_record"]
// r11: DENY users whose employment type is contractor to perform any action on resources where type is medical record, when network is not corporate.
create prohibition "r11-employment_type=contractor" deny user attribute "employment_type=contractor" access rights ["*"] on intersection of ["type=medical_record"]
// r13: DENY anyone to perform delete on resources where type is audit log.
create prohibition "r13-all_users" deny user attribute "all_users" access rights ["delete"] on intersection of ["type=audit_log"]

