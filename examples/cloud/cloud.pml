// NGAC policy (PML) generated by Raivana for policy 'cloud'
// Fingerprint 1b3cc23b2067632e. NGAC is deny-by-default: access requires an association.

create policy class "cloud"

create user attribute "all_users" in ["cloud"]
create user attribute "role=developer" in ["all_users"]
create user attribute "role=devops" in ["all_users"]
create user attribute "role=admin" in ["all_users"]
create user attribute "role=dba" in ["all_users"]
create user attribute "role=service_account" in ["all_users"]
create user attribute "employment_type=contractor" in ["all_users"]
create user attribute "role=intern" in ["all_users"]

create object attribute "all_objects" in ["cloud"]
create object attribute "type=source_code" in ["all_objects"]
create object attribute "tier=staging" in ["all_objects"]
create object attribute "tier=production" in ["all_objects"]
create object attribute "type=server" in ["all_objects"]
create object attribute "tier=production & type=server" in ["tier=production", "type=server"]
create object attribute "type=database" in ["all_objects"]
create object attribute "tier=production & type=database" in ["tier=production", "type=database"]
create object attribute "type=backup" in ["all_objects"]
create object attribute "type=secret" in ["all_objects"]

// r1: ALLOW users whose role is developer to perform read on resources where type is source code.
associate "role=developer" and "type=source_code" with ["read"]
// r2: ALLOW users whose role is developer to perform deploy on resources where tier is staging.
associate "role=developer" and "tier=staging" with ["deploy"]
// r3: ALLOW users whose role is devops to perform deploy on resources where tier is production.
associate "role=devops" and "tier=production" with ["deploy"]
// r5: ALLOW users whose role is devops to perform deploy on resources where tier is production, when the time is outside 06:00-22:00.
associate "role=devops" and "tier=production" with ["deploy"]
// r7: ALLOW users whose role is admin to perform any action on resources where tier is production and type is server, when mfa is satisfied.
associate "role=admin" and "tier=production & type=server" with ["*"]
// r9: ALLOW users whose role is dba to perform manage on resources where tier is production and type is database, when device is managed.
associate "role=dba" and "tier=production & type=database" with ["manage"]
// r12: ALLOW users whose employment type is contractor to perform any action on resources where type is secret, when network is corporate.
associate "employment_type=contractor" and "type=secret" with ["*"]

// r6: DENY users whose role is devops to perform deploy on resources where tier is production, when the time is within 06:00-22:00.
create prohibition "r6-role=devops" deny user attribute "role=devops" access rights ["deploy"] on intersection of ["tier=production"]
// r8: DENY users whose role is admin to perform any action on resources where tier is production and type is server, when mfa is not satisfied.
create prohibition "r8-role=admin" deny user attribute "role=admin" access rights ["*"] on intersection of ["tier=production & type=server"]
// r10: DENY users whose role is service account to perform delete on resources where type is backup.
create prohibition "r10-role=service_account" deny user attribute "role=service_account" access rights ["delete"] on intersection of ["type=backup"]
// r11: DENY users whose employment type is contractor to perform any action on resources where type is secret, when network is not corporate.
create prohibition "r11-employment_type=contractor" deny user attribute "employment_type=contractor" access rights ["*"] on intersection of ["type=secret"]
// r13: DENY users whose role is intern to perform any action on resources where tier is production.
create prohibition "r13-role=intern" deny user attribute "role=intern" access rights ["*"] on intersection of ["tier=production"]

