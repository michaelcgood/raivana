# Copy this file to `.env` (same folder you run raivana from) or to ~/.raivana/.env
# and fill in what you need. `.env` is git-ignored, so never commit your real keys.
#
# Everything is optional: with no key, Raivana runs its free offline engine.

# --- Claude (Anthropic) - enables the "claude" and "hybrid" engines -----------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Default model: an alias (haiku | sonnet | opus | fable) or a full model id. Default: sonnet
# RAIVANA_MODEL=sonnet

# --- Use Claude through your cloud provider instead (optional) ----------------------
# RAIVANA_PROVIDER=bedrock          # anthropic | bedrock | vertex | foundry
# AWS_REGION=us-east-1              # bedrock (uses your normal AWS credentials)
# GOOGLE_CLOUD_PROJECT=my-project   # vertex (uses gcloud application-default credentials)
# GOOGLE_CLOUD_REGION=global
# ANTHROPIC_FOUNDRY_API_KEY=        # foundry
# ANTHROPIC_FOUNDRY_RESOURCE=

# --- Web server (only if you expose `raivana serve` beyond your own machine) --------
# RAIVANA_SERVER_TOKEN=change-me    # require "Authorization: Bearer <token>" on API calls
# RAIVANA_DISABLE_LLM=1             # force the free offline engine (no API spend)
